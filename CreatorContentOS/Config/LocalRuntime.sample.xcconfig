# xcconfig treats // as a comment, so https:/$()/ expands to https://.
MCO_SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
MCO_SUPABASE_PUBLISHABLE_KEY = YOUR-PUBLISHABLE-OR-ANON-KEY
INSTAGRAM_APP_ID = YOUR-META-APP-ID
INSTAGRAM_REDIRECT_URI = https:/$()/YOUR-PROJECT-REF.functions.supabase.co/ig-oauth-redirect
INSTAGRAM_LOGIN_CONFIG_ID = YOUR-FACEBOOK-LOGIN-FOR-BUSINESS-CONFIG-ID
